<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_item_root"
    android:layout_width="56dp"
    android:layout_height="72dp"
    android:clickable="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:longClickable="false">

    <LinearLayout
        android:id="@+id/day_item_upright"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="1dp"
        android:paddingEnd="1dp"
        android:rotation="90">

        <TextView
            android:id="@+id/day_item_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#B0040C1A"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:singleLine="true"
            android:textColor="#F8FAFC"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/day_item_cloud_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/day_item_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/day_item_rain_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="0dp"
                android:shadowColor="#B0040C1A"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:singleLine="true"
                android:textColor="#7DD3FC"
                android:textSize="8.8sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/day_item_hilo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#B0040C1A"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:singleLine="true"
            android:textColor="#F8FAFC"
            android:textSize="9.5sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
