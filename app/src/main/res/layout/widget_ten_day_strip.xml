<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_ten_day_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:longClickable="false">

    <!-- Isotropic 0.025x scale amplifies inverse-matrix touch deltas by 40x (~1.1px / <0.1mm threshold)
         so ListView claims horizontal finger touches on the very first touch micro-movement and cancels
         Samsung One UI 7 HoneySpace's widget long-press / drag timer immediately. -->
    <ListView
        android:id="@+id/widget_ten_day_list"
        android:layout_width="160dp"
        android:layout_height="960dp"
        android:layout_gravity="center"
        android:cacheColorHint="@android:color/transparent"
        android:clickable="false"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:fadingEdge="none"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:listSelector="@android:color/transparent"
        android:longClickable="false"
        android:overScrollMode="never"
        android:rotation="270"
        android:scaleX="0.025"
        android:scaleY="0.025"
        android:scrollbars="none" />

</FrameLayout>
